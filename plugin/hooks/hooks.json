{
  "description": "Streams Claude Code activity to the Crab Quest game server.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 -X POST -H 'Content-Type: application/json' --data-binary @- \"${CRAB_QUEST_URL:-http://localhost:7777}/hook\" >/dev/null 2>&1 || true # crab-quest",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
